# =============================================================================
# LAB532 — C# track .env
# Copy this file to `.env` in this folder and fill in the values.
#   cp .env.sample .env     (macOS / Linux)
#   Copy-Item .env.sample .env    (PowerShell)
# Never commit .env to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — used by every Part (1–5)
# -----------------------------------------------------------------------------

# Azure AI Search service that hosts your Foundry IQ knowledge bases.
# Format: https://<service-name>.search.windows.net
AZURE_SEARCH_SERVICE_ENDPOINT=https://your-search-service.search.windows.net

# Admin key for the search service above (Portal → Keys → Primary admin key).
AZURE_SEARCH_ADMIN_KEY=your-search-admin-key

# Azure OpenAI / Microsoft Foundry Models endpoint used by the local MAF agent
# that queries the KB through its MCP endpoint.
# Format: https://<resource>.services.ai.azure.com/  or  https://<resource>.openai.azure.com/
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.services.ai.azure.com/
AZURE_OPENAI_KEY=your-openai-api-key

# Chat deployment + model name (must already exist in the resource above).
AZURE_OPENAI_CHATGPT_DEPLOYMENT=gpt-5.4-mini
AZURE_OPENAI_CHATGPT_MODEL_NAME=gpt-5.4-mini

# -----------------------------------------------------------------------------
# REQUIRED for Parts 3, 4, 5 — delegated query-source token
# -----------------------------------------------------------------------------
# Used by DefaultAzureCredential to acquire the https://search.azure.com/.default
# token that retrieves from Fabric Ontology or Work IQ knowledge sources.
# Also: run `az login --tenant $AZURE_TENANT_ID` before running those Parts.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# -----------------------------------------------------------------------------
# Part 2 only — Web IQ (web grounding)
# -----------------------------------------------------------------------------
# Key for the Web IQ service (https://api.microsoft.ai/v3/mcp).
WEB_IQ_KEY=your-web-iq-key

# -----------------------------------------------------------------------------
# Parts 3 and 5 only — Fabric IQ ontology
# -----------------------------------------------------------------------------
# Microsoft Fabric workspace and ontology IDs (from the Fabric portal URL).
FABRIC_WORKSPACE_ID=00000000-0000-0000-0000-000000000000
FABRIC_ONTOLOGY_ID=00000000-0000-0000-0000-000000000000
